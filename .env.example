APP_NAME=MIVO
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# RouterOS transport
ROUTEROS_TLS=true
ROUTEROS_TLS_CA_FILE=
ROUTEROS_ALLOW_INSECURE=false

# Database
DB_PATH=/app/Database/database.sqlite

# Public status API throttling
PUBLIC_STATUS_MAX_ATTEMPTS=30
PUBLIC_STATUS_WINDOW_SECONDS=60

# Login throttling
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
